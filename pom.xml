<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.eclipse.kura</groupId>
    <artifactId>kura-yofc-runtime</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Kura YOFC Runtime Support Libraries</name>
    <description>
        Pure library sibling shipping yofc-iot runtime dependencies (fastjson2,
        javacan, vertx-*) that yofc-iot bundles consume with provided scope.
        Drops jars at /opt/eclipse/kura/siblings/yofc-runtime/6/.
    </description>

    <properties>
        <fastjson2.version>2.0.62</fastjson2.version>
        <javacan.version>3.5.2</javacan.version>
        <vertx.version>5.1.4</vertx.version>
        <!-- digitalpetri: yofc-iot opcuaserver bundle Import-Packages com.digitalpetri.fsm
             + com.digitalpetri.netty.fsm at runtime (not embedded in its jar). Also shipped
             by kura-opcua.deb; both ship same filenames so gen_config_ini.sh dedupes. -->
        <com.digitalpetri.strict-machine.version>1.0.0</com.digitalpetri.strict-machine.version>
        <com.digitalpetri.channel-fsm.version>1.0.2</com.digitalpetri.channel-fsm.version>
        <ojdbc.version>23.4.0.24.05</ojdbc.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>2.8.2</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>target-platform</module>
        <module>bundles</module>
        <module>kura-yofc-runtime-pde-deps</module>
        <module>distrib</module>
        <module>dp</module>
    </modules>
</project>

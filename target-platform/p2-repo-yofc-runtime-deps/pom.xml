<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.kura</groupId>
        <artifactId>kura-yofc-runtime-target-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>p2-repo-yofc-runtime-deps</artifactId>
    <packaging>pom</packaging>
    <name>P2 site for kura-yofc-runtime-specific deps</name>

    <build>
        <plugins>
            <plugin>
                <groupId>org.reficio</groupId>
                <artifactId>p2-maven-plugin</artifactId>
                <version>${p2-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>generate-p2-site</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>site</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <!--
                                    yofc-runtime-exclusive jars that ship in kura-yofc-runtime.deb.
                                    Wrapped here as proper OSGi bundles so PDE / Kura Emulator can
                                    resolve their Import-Packages in the IDE.

                                    Monorepo already wraps vertx-core / vertx-web-common /
                                    vertx-web-client (kura-camel + others Import them). digitalpetri
                                    is wrapped by kura-opcua. So those four are NOT duplicated here.
                                -->

                                <artifact>
                                    <id>com.alibaba.fastjson2:fastjson2:jar:${fastjson2.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>
                                <artifact>
                                    <id>tel.schich:javacan-core:jar:${javacan.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>

                                <!-- yofc-only Vert.x bundles (8). -->
                                <artifact>
                                    <id>io.vertx:vertx-auth-common:${vertx.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>
                                <artifact>
                                    <id>io.vertx:vertx-bridge-common:${vertx.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>
                                <artifact>
                                    <id>io.vertx:vertx-core-logging:${vertx.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>
                                <artifact>
                                    <id>io.vertx:vertx-http-proxy:${vertx.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>
                                <artifact>
                                    <id>io.vertx:vertx-mqtt:${vertx.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>
                                <artifact>
                                    <id>io.vertx:vertx-tcp-eventbus-bridge:${vertx.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>
                                <artifact>
                                    <id>io.vertx:vertx-uri-template:${vertx.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>
                                <artifact>
                                    <id>io.vertx:vertx-web:${vertx.version}</id>
                                    <source>true</source>
                                    <transitive>false</transitive>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>install-p2-bundles-to-local-m2</id>
                        <phase>install</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="${project.basedir}/../install-to-m2.sh"
                                      dir="${project.basedir}"
                                      failonerror="true">
                                    <arg value="${project.build.directory}/repository/plugins" />
                                    <arg value="p2.osgi.bundle" />
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
    </repositories>
</project>

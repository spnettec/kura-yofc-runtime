<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.kura</groupId>
        <artifactId>kura-yofc-runtime</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>kura-yofc-runtime-pde-deps</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <packaging>pom</packaging>
    <name>Kura YOFC Runtime PDE Deps</name>

    <!-- Eclipse-IDE-only delta: developers add this pom as a Maven Artifact
         Target Entry on top of the monorepo target so PDE / Kura Emulator
         launch configs can resolve the yofc-iot runtime support bundle
         (com.yofc.iot.runtime) that ships via kura-yofc-runtime.deb at
         /opt/eclipse/kura/siblings/yofc-runtime/6/.

         Tycho production builds don't use this — the bundle is not in
         the monorepo or any sibling Tycho reactor.

         One-time setup per fresh ~/.m2:
             mvn -f kura-yofc-runtime/pom.xml install
    -->
    <dependencies>
        <!-- Single fat OSGi bundle embedding fastjson2, javacan, vertx-*,
             digitalpetri, and SQL clients + JDBC drivers. -->
        <dependency>
            <groupId>com.yofc.iot</groupId>
            <artifactId>yofc-iot-runtime</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>2.8.2</version>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

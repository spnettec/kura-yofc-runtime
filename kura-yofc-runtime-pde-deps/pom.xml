<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.kura</groupId>
        <artifactId>kura-yofc-runtime</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>kura-yofc-runtime-pde-deps</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <packaging>pom</packaging>
    <name>Kura YOFC Runtime PDE Deps</name>

    <!-- Eclipse-IDE-only delta: developers add this pom as a Maven Artifact
         Target Entry on top of the monorepo target so PDE / Kura Emulator
         launch configs can resolve the yofc-iot runtime support bundles
         (fastjson2, javacan, yofc-only vertx-*, digitalpetri, repack-vertx-db)
         that ship via kura-yofc-runtime.deb at
         /opt/eclipse/kura/siblings/yofc-runtime/6/.

         Tycho production builds don't use this — these bundles are not in
         the monorepo or any sibling Tycho reactor.

         The 10 non-OSGi (or weakly-OSGi) jars are wrapped into proper P2
         bundles by kura-yofc-runtime/target-platform/p2-repo-yofc-runtime-deps
         and referenced here as p2.osgi.bundle:* GAVs. digitalpetri (kura-opcua
         already wraps it) and the bnd-produced repack-vertx-db bundle are
         referenced via their native GAVs.

         One-time setup per fresh ~/.m2:
             mvn -f kura-yofc-runtime/target-platform/pom.xml install
             mvn -f kura-yofc-runtime/pom.xml install
    -->
    <dependencies>
        <!-- 10 reficio-wrapped runtime jars. -->
        <dependency>
            <groupId>p2.osgi.bundle</groupId>
            <artifactId>com.alibaba.fastjson2</artifactId>
            <version>${fastjson2.version}</version>
        </dependency>
        <dependency>
            <groupId>p2.osgi.bundle</groupId>
            <artifactId>tel.schich.javacan-core</artifactId>
            <version>${javacan.version}</version>
        </dependency>
        <dependency>
            <groupId>p2.osgi.bundle</groupId>
            <artifactId>io.vertx.auth-common</artifactId>
            <version>${vertx.version}</version>
        </dependency>
        <dependency>
            <groupId>p2.osgi.bundle</groupId>
            <artifactId>io.vertx.bridge-common</artifactId>
            <version>${vertx.version}</version>
        </dependency>
        <dependency>
            <groupId>p2.osgi.bundle</groupId>
            <artifactId>io.vertx.core-logging</artifactId>
            <version>${vertx.version}</version>
        </dependency>
        <dependency>
            <groupId>p2.osgi.bundle</groupId>
            <artifactId>io.vertx.http-proxy</artifactId>
            <version>${vertx.version}</version>
        </dependency>
        <dependency>
            <groupId>p2.osgi.bundle</groupId>
            <artifactId>io.vertx.mqtt</artifactId>
            <version>${vertx.version}</version>
        </dependency>
        <dependency>
            <groupId>p2.osgi.bundle</groupId>
            <artifactId>io.vertx.tcp-eventbus-bridge</artifactId>
            <version>${vertx.version}</version>
        </dependency>
        <dependency>
            <groupId>p2.osgi.bundle</groupId>
            <artifactId>io.vertx.uri-template</artifactId>
            <version>${vertx.version}</version>
        </dependency>
        <dependency>
            <groupId>p2.osgi.bundle</groupId>
            <artifactId>io.vertx.web</artifactId>
            <version>${vertx.version}</version>
        </dependency>

        <!-- digitalpetri: already wrapped by kura-opcua target-platform. -->
        <dependency>
            <groupId>p2.osgi.bundle</groupId>
            <artifactId>com.digitalpetri.fsm.strict-machine</artifactId>
            <version>${com.digitalpetri.strict-machine.version}</version>
        </dependency>
        <dependency>
            <groupId>p2.osgi.bundle</groupId>
            <artifactId>com.digitalpetri.netty.channel-fsm</artifactId>
            <version>${com.digitalpetri.channel-fsm.version}</version>
        </dependency>

        <!-- bnd-produced OSGi bundle (kura-yofc-runtime/bundles/...); native GAV. -->
        <dependency>
            <groupId>com.yofc.iot</groupId>
            <artifactId>yofc-iot-repack-vertx-db</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>2.8.2</version>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
